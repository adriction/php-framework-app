# Copier ce fichier en ".env" (make install le fait automatiquement).

# dev = pages d'erreur detaillees avec stacktrace / prod = erreurs loguees dans var/log/
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me

# Port expose par nginx sur la machine hote -> http://localhost:APP_PORT
# 8092 choisi car 8080/8082/8091 sont deja pris par d'autres projets locaux (dont php-framework lui-meme).
APP_PORT=8092

# URL publique du site (fonction Twig url(), Open Graph/canonical...). A remplacer par le vrai domaine en prod.
APP_URL=http://localhost:8092

# Connexion MariaDB (le host "mariadb" est le nom du service docker-compose)
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=php_framework_app
DB_USER=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=root

# Port MariaDB expose sur la machine hote (pour un client SQL externe)
# 3311 choisi car 3306-3310 sont deja pris par d'autres projets locaux (dont php-framework lui-meme).
DB_EXPOSED_PORT=3311

# SMTP (Framework\Mail\PhpMailerMailer). En dev, host/port par defaut pointent
# sur un Mailpit local (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit).
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_AUTH=0
MAILER_USERNAME=
MAILER_PASSWORD=
MAILER_ENCRYPTION=
MAILER_FROM_ADDRESS=no-reply@example.com
MAILER_FROM_NAME=php-framework-app
